# PostgreSQL Database Connection
# For Docker: postgresql://postgres:postgres@postgres:5432/earnings
# For local: postgresql://user@localhost:5432/earnings
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/earnings

# OpenAI API (required for Q&A and organization extraction)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-heresk-your-openai-api-key-here
