# ===== DATABASE CONFIGURATION =====
# PostgreSQL connection string
# For Docker: postgresql://postgres:postgres@postgres:5432/earnings
# For local: postgresql://user:password@localhost:5432/earnings_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/earnings

# ===== API KEYS =====
# OpenAI API key for embeddings and Q&A
OPENAI_API_KEY=sk-your-openai-api-key-here
